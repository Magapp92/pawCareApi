# Copiar este archivo como .env y rellenar los valores

# Puerto donde arranca la API
PORT=3000

# Cadena de conexión a MongoDB (local o Atlas)
# Local:  mongodb://127.0.0.1:27017/pawcare  (127.0.0.1 y no localhost: con Node 18+ localhost puede resolver a IPv6 y Mongo escucha en IPv4)
# Atlas:  mongodb+srv://usuario:contraseña@cluster.xxxxx.mongodb.net/pawcare
MONGO_URI=mongodb://127.0.0.1:27017/pawcare

# Clave con la que se firman los tokens de sesión: cualquier cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
